# Supabase Compose serving-only AI configuration. Keep only these keys here.
# Do not pass the full .env to the Supabase Compose stack.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_CHAT_MODEL=google-genai
AI_EMBEDDING_MODEL=google-genai
RAG_EMBEDDING_DIMENSIONS=1024
# Optional OpenAI chat; embeddings stay on Gemini.
AI_CHAT_PROVIDER=gemini
OPENAI_API_KEY=
# Optional: another OpenAI model (default gpt-4.1-mini). Reasoning models need an effort such as none or low.
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
