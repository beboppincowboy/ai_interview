DATABASE_URL=jdbc:postgresql://localhost:5432/interview_guide
DATABASE_USERNAME=ai_interview
DATABASE_PASSWORD=change_me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=6380
REDIS_RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_AI_RATE_LIMIT=12
REDIS_UPLOAD_RATE_LIMIT=20
REDIS_IDEMPOTENCY_ENABLED=true
REDIS_IDEMPOTENCY_TTL_SECONDS=86400

S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=ai-interview
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
RESUME_PENDING_RETENTION_HOURS=24
RESUME_STORAGE_CLEANUP_INTERVAL_MS=300000
RESUME_PARSER_QUEUE_CAPACITY=2
RESUME_EXTRACTION_TIMEOUT_SECONDS=20
RESUME_MAX_PARSE_CHARS=250000
RESUME_MAX_PDF_PAGES=50
RESUME_MAX_EMBEDDED_RESOURCES=20

SQS_ENDPOINT=http://localhost:4566
SQS_REGION=us-east-1
SQS_ACCESS_KEY=test
SQS_SECRET_KEY=test
SQS_QUEUE_NAME=ai-interview-jobs
SQS_DLQ_NAME=ai-interview-jobs-dlq
SQS_MAX_RECEIVE_COUNT=3
JOBS_ENABLED=true
JOB_RUNTIME_MODE=all
JOB_WORKER_CONCURRENCY=2
JOB_LONG_POLL_SECONDS=20
JOB_VISIBILITY_TIMEOUT_SECONDS=300
JOB_HEARTBEAT_SECONDS=60
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=15
JOB_DISPATCH_INTERVAL_MS=5000
JOB_LEASE_REAPER_INTERVAL_MS=30000
JOB_CLEANUP_INTERVAL_MS=3600000
JOB_SHUTDOWN_GRACE_SECONDS=120
JOB_RETENTION_DAYS=7

# Required for AI results, also in `docker compose --profile app`, whose API and worker read this file.
# With a key set, switch AI_CHAT_MODEL and AI_EMBEDDING_MODEL to google-genai.
GEMINI_API_KEY=
AI_CHAT_MODEL=none
AI_EMBEDDING_MODEL=none
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=90
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_THINKING_LEVEL=medium
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional: generate AI results with OpenAI instead of Gemini. Embeddings stay on Gemini, so GEMINI_API_KEY is still needed.
AI_CHAT_PROVIDER=gemini
OPENAI_API_KEY=
# Optional: another OpenAI model (default gpt-4.1-mini). Reasoning models need an effort such as none or low.
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
RAG_EMBEDDING_DIMENSIONS=1024
RAG_DEFAULT_TOP_K=8
RAG_RESUME_CANDIDATE_TOP_K=6
RAG_JOB_DESCRIPTION_CANDIDATE_TOP_K=4
RAG_ASSESSMENT_CONTEXT_BUDGET=14
RAG_QUESTION_CONTEXT_BUDGET=16
RAG_FEEDBACK_CONTEXT_BUDGET=10
RAG_ASSESSMENT_JD_MINIMUM=3
RAG_QUESTION_JD_MINIMUM=3
RAG_FEEDBACK_JD_MINIMUM=2
RAG_SECTION_MAXIMUM=3
RAG_RRF_K=15
RAG_CHUNK_SCHEMA=section-block-v3
REDIS_KEY_PREFIX=ai-interview:v3:

# Optional local API SDK settings. Keep the server key in the API process environment only.
SUPABASE_SDK_ENABLED=false
SUPABASE_URL=

# Bootstrap credentials belong only in ignored .env.supabase; serving processes do not import it.
# See docs/supabase-migration.md for the isolated Supabase Compose stack.
SUPABASE_SSL_ROOT_CERT=
DATABASE_MAX_POOL_SIZE=4
# Supabase runtime DATABASE_URL uses session pooler port 5432 and
# ?sslmode=verify-full&currentSchema=public,extensions
# DATABASE_USERNAME=ai_interview_runtime.mjzycnjhtwyqcblwbjvy
# DATABASE_PASSWORD=<new runtime role password>
# Use fresh REDIS_KEY_PREFIX, S3_BUCKET, SQS_QUEUE_NAME and SQS_DLQ_NAME.
